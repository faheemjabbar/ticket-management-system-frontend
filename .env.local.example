# Backend API URL
# Development (local backend)
NEXT_PUBLIC_API_URL=http://localhost:5050

# Production (Railway deployment)
# Uncomment and update with your actual backend URL for production
# NEXT_PUBLIC_API_URL=https://ticket-management-system-backend-production.up.railway.app

# IMPORTANT FOR PRODUCTION:
# 1. Make sure your backend URL does NOT have a trailing slash
# 2. Set this environment variable in your hosting platform (Vercel/Netlify/etc.)
# 3. The backend must have CORS configured to allow your frontend domain

# Mock Authentication Mode (for testing without backend)
# Set to 'true' to use mock users, 'false' or remove to use real backend
NEXT_PUBLIC_USE_MOCK_AUTH=false
